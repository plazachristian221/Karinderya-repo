# =========================================================
# ORDER
# =========================================================

@app.route("/order", methods=["GET", "POST"])
def order():

    # User must be logged in
    if "username" not in session:

        return redirect(url_for("login"))

    # -----------------------------------------------------
    # POST - SAVE ORDER
    # -----------------------------------------------------

    if request.method == "POST":

        restaurant_id = request.form.get(
            "restaurant_id"
        )

        food = request.form.get(
            "food"
        )

        price = request.form.get(
            "price"
        )

        payment_method = request.form.get(
            "payment_method"
        )

        # Check required fields
        if not all([
            restaurant_id,
            food,
            price,
            payment_method
        ]):

            return "Missing required fields.", 400

        # Check restaurant
        try:

            restaurant_id = int(restaurant_id)

        except ValueError:

            return "Invalid restaurant.", 400

        restaurant_data = restaurants.get(
            restaurant_id
        )

        if restaurant_data is None:

            return "Karinderya not found.", 404

        # Check price
        try:

            price = float(price)

        except ValueError:

            return "Invalid price.", 400

        # Current logged-in user
        username = session["username"]

        # Payment status
        if payment_method == "Cash on Pickup":

            payment_status = "Pay on Pickup"

        else:

            payment_status = "Pending"

        # Initial order status
        order_status = "Waiting"

        # Date and time
        created_at = datetime.now().strftime(
            "%Y-%m-%d %H:%M:%S"
        )

        conn = get_db()

        # Insert order
        cursor = conn.execute(
            """
            INSERT INTO orders
            (
                username,
                restaurant_id,
                restaurant_name,
                food,
                price,
                payment_method,
                payment_status,
                order_status,
                created_at
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                username,
                restaurant_id,
                restaurant_data["name"],
                food,
                price,
                payment_method,
                payment_status,
                order_status,
                created_at
            )
        )

        conn.commit()

        order_id = cursor.lastrowid

        conn.close()

        # Go to queue page
        return redirect(
            url_for(
                "queue",
                order_id=order_id
            )
        )

    # -----------------------------------------------------
    # GET - ORDER CONFIRMATION PAGE
    # -----------------------------------------------------

    restaurant_id = request.args.get(
        "restaurant_id"
    )

    food = request.args.get(
        "food"
    )

    price = request.args.get(
        "price"
    )

    if not restaurant_id:

        return "Restaurant is required.", 400

    try:

        restaurant_id = int(restaurant_id)

    except ValueError:

        return "Invalid restaurant.", 400

    restaurant_data = restaurants.get(
        restaurant_id
    )

    if restaurant_data is None:

        return "Karinderya not found.", 404

    return render_template(
        "order.html",
        restaurant=restaurant_data,
        restaurant_id=restaurant_id,
        food=food,
        price=price
    )


