@app.route("/queue/<int:order_id>")
def queue(order_id):

    # User must be logged in
    if "username" not in session:

        return redirect(url_for("login"))

    conn = get_db()

    order_data = conn.execute(
        """
        SELECT *
        FROM orders
        WHERE id = ?
        AND username = ?
        """,
        (
            order_id,
            session["username"]
        )
    ).fetchone()

    conn.close()

    if order_data is None:

        return "Order not found.", 404

    return render_template(
        "queue.html",
        order=order_data
    )


